{
  "name": "specbridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Portable requirement contracts and AI review coverage interoperability.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "schemas": "tsx scripts/generate-schemas.ts",
    "pack:verify": "tsx scripts/verify-packages.ts",
    "release:check": "pnpm schemas && pnpm typecheck && pnpm lint && pnpm build && pnpm test && pnpm pack:verify",
    "specbridge": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.33.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "zod-to-json-schema": "^3.24.5"
  }
}
