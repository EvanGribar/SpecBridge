  "devDependencies": { "@eslint/js": "^9.33.0", "@types/node": "^22.15.3", "eslint": "^9.33.0", "typescript": "^5.8.3", "tsx": "^4.19.3", "vitest": "^3.1.2", "zod-to-json-schema": "^3.24.5" }
