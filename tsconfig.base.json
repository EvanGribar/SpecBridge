{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@specbridge/core": ["packages/core/src/index.ts"],
      "@specbridge/parsers": ["packages/parsers/src/index.ts"],
      "@specbridge/repository": ["packages/repository/src/index.ts"],
      "@specbridge/rules": ["packages/rules/src/index.ts"],
      "@specbridge/adapters": ["packages/adapters/src/index.ts"],
      "@specbridge/sarif": ["packages/sarif/src/index.ts"],
      "@specbridge/cli": ["packages/cli/src/index.ts"],
      "@specbridge/benchmark": ["packages/benchmark/src/index.ts"],
      "@specbridge/benchmark-adapters": ["packages/benchmark-adapters/src/index.ts"]
    }
  }
}
