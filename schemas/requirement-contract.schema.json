              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
