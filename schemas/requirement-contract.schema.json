                      "minLength": 1
                    },
                    "metadata": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "id",
                    "description"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "source": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "$ref": "#/definitions/requirement-contract/properties/source/properties/path"
                  },
