{
  "$ref": "#/definitions/coverage-report",
  "definitions": {
    "coverage-report": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "contractId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "reviewer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "commitSha": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "baseUri": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "properties": {
            "startedAt": {
              "type": "string",
              "format": "date-time"
            },
            "completedAt": {
              "type": "string",
              "format": "date-time"
            },
            "runId": {
              "type": "string",
              "minLength": 1
            },
            "metadata": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "additionalProperties": false
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirementId": {
                "$ref": "#/definitions/coverage-report/properties/contractId"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "blocking",
                  "warning",
                  "informational"
                ]
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "criterionId": {
                      "$ref": "#/definitions/coverage-report/properties/contractId"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "satisfied",
                        "violated",
                        "not_verifiable",
                        "not_applicable"
                      ]
                    },
                    "explanation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          "startLine": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                          },
                          "endLine": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                          },
                          "symbol": {
                            "type": "string",
                            "minLength": 1
                          },
                          "explanation": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uri": {
                            "type": "string",
                            "format": "uri"
                          }
                        },
                        "required": [
                          "path",
                          "startLine"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "criterionId",
                    "status",
                    "explanation",
                    "evidence"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "requirementId",
              "criteria"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "metadata": {
          "$ref": "#/definitions/coverage-report/properties/execution/properties/metadata"
        }
      },
      "required": [
        "schemaVersion",
        "contractId",
        "reviewer",
        "target",
        "requirements"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
