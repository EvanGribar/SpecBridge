{
  "name": "@specbridge/cli",
  "version": "0.4.0",
  "description": "SpecBridge helps make repository-based AI coding agents more reliable by auditing their instructions and benchmarking requirement adherence.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvanGribar/SpecBridge.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/EvanGribar/SpecBridge#readme",
  "bugs": {
    "url": "https://github.com/EvanGribar/SpecBridge/issues"
  },
  "keywords": [
    "cli",
    "audit",
    "agent-instructions",
    "sarif",
    "specbridge"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "specbridge": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@specbridge/adapters": "workspace:^",
    "@specbridge/benchmark": "workspace:^",
    "@specbridge/core": "workspace:^",
    "@specbridge/parsers": "workspace:^",
    "@specbridge/repository": "workspace:^",
    "@specbridge/rules": "workspace:^",
    "@specbridge/sarif": "workspace:^"
  }
}
