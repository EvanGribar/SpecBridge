{
  "name": "@specbridge/repository",
  "version": "0.2.0",
  "description": "Repository scanner and inventory collector for SpecBridge.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvanGribar/SpecBridge.git",
    "directory": "packages/repository"
  },
  "homepage": "https://github.com/EvanGribar/SpecBridge#readme",
  "bugs": {
    "url": "https://github.com/EvanGribar/SpecBridge/issues"
  },
  "keywords": ["repository", "inventory", "package-manager", "scripts"],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@specbridge/core": "workspace:^",
    "@specbridge/parsers": "workspace:^"
  }
}
